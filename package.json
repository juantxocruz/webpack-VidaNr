{
  "name": "nacionalRe VidaNr",
  "version": "1.0.0",
  "description": "VidaNr calculator frontend project based on webpack 5.",
  "scripts": {
    "lint": "npm run lint:styles && npm run lint:scripts",
    "lint:styles": "stylelint src",
    "lint:scripts": "eslint src",
    "start": "cross-env SERVE=true NODE_ENV=development webpack serve --config webpack/webpack.config.dev.js --open",
    "build:nacionalRe": "cross-env NODE_ENV=production ASSET_PATH=/calculadora-vidanr/build/ webpack --config webpack/webpack.config.prod.js",
    "build:botsoul": "cross-env NODE_ENV=production ASSET_PATH=/pruebas/nacionalRe-vidaNr/build/ webpack --config webpack/webpack.config.prod.js",
    "clean": "rimraf ./build",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juantxocruz/webpack-vidaNr.git"
  },
  "keywords": [
    "webpack",
    "startkit",
    "frontend",
    "es6",
    "javascript",
    "webdev"
  ],
  "author": "Juantxo Cruz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/juantxocruz/webpack-vidaNr"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.24.7",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-webpack-plugin": "^6.0.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "install": "^0.13.0",
    "jest": "^30.4.2",
    "mini-css-extract-plugin": "^2.9.0",
    "npm": "^11.14.1",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^11.2.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.3",
    "sass": "^1.77.5",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "webpack": "^5.92.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@npmcli/fs": "^5.0.0",
    "core-js": "^3.37.1",
    "d3": "^7.9.0",
    "glob": "^13.0.6"
  }
}
