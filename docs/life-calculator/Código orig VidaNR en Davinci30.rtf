\f0 \'a0\'a0\'a0\'a0 \'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0\'a0 lnColes=_LATEMP(1,3)
\f1 \

\f0 \'a0\'a0\'a0\'a0 ENDIF
\f1 \

\f0 ELSE
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnColes=0
\f1 \

\f0 ENDIF
\f1 \

\f0 \'a0
\f1 \

\f0 && Fin Colesterol
\f1 \

\f0 \'a0
\f1 \

\f0 * Ya tengo las 5 variables con porcentajes
\f1 \

\f0 * lnIMC
\f1 \

\f0 * lnTension
\f1 \

\f0 * lnFuma
\f1 \

\f0 * lnBebe
\f1 \

\f0 * lnColes
\f1 \

\f0 \'a0
\f1 \

\f0 && Para ILT tienen los nombres _ILT menos tensi\'f3n, que es com\'fan
\f1 \

\f0 \'a0
\f1 \

\f0 * Comprobamos que no haya rechazos/aplazaminentos
\f1 \

\f0 local TxtMensaje
\f1 \

\f0 TxtMensaje=""
\f1 \

\f0 DO CASE
\f1 \

\f0 \'a0\'a0\'a0\'a0 CASE lnIMC=-1
\f1 \

\f0 \'a0\'a0\'a0\'a0 TxtMensaje="Debido a la relaci\'f3n peso/altura esta solicitud debe ser rechazada"
\f1 \

\f0 \'a0\'a0\'a0\'a0 CASE lnIMC=-2
\f1 \

\f0 \'a0\'a0\'a0\'a0 TxtMensaje="Debido a la relaci\'f3n peso/altura esta solicitud debe ser aplazada"
\f1 \

\f0 \'a0\'a0\'a0\'a0 CASE lnTension=-1
\f1 \

\f0 \'a0\'a0\'a0\'a0 TxtMensaje="Debido a la tensi\'f3n arterial esta solicitud debe ser rechazada"
\f1 \

\f0 ENDCASE
\f1 \

\f0 \'a0
\f1 \

\f0 IF !EMPTY(TxtMensaje)
\f1 \

\f0 \'a0\'a0\'a0\'a0 =messagebox(TxtMensaje,64,"C\'e1lculo cancelado")
\f1 \

\f0 \'a0\'a0\'a0\'a0 RETURN .f.
\f1 \

\f0 ENDIF
\f1 \

\f0 \'a0
\f1 \

\f0 && Contamos el n\'famero de agravamientos, pues es clave luego para el recargo (usado como potencia)
\f1 \

\f0 local nagra
\f1 \

\f0 nagra=IIF(lnIMC>0,1,0)+IIF(lnTension>0,1,0)+IIF(lnFuma>0,1,0)+IIF(lnBebe>0,1,0)+IIF(lnColes>0,1,0)
\f1 \

\f0 \'a0
\f1 \

\f0 local lnTVida,lnTInva,lnTAcci,lnTEnf,lnTILT,lnMax
\f1 \

\f0 && Estos c\'e1culos convierten a m\'faltiplos de 25, enteros, penalizando mucho (elevado a nagra) si coinciden varios motivos de recargo.
\f1 \

\f0 lnTVida=ROUND((lnIMC+lnTension+lnFuma+lnBebe+lnColes)*(1.1^(nagra-1))/25,0)*25
\f1 \

\f0 && lnTInva=lnTVida\'a0\'a0\'a0\'a0 && MPL cambia el 04/09/2018 para que calcule como Vida, pero rechazando alcohol si procede (>75)
\f1 \

\f0 lnTInva=ROUND((lnIMC+lnTension+lnFuma+IIF(lnBebe<=75,lnBebe,999)+lnColes)*(1.1^(nagra-1))/25,0)*25
\f1 \

\f0 lnTAcci=ROUND(((lnIMC/2)+lnTension+lnFuma+IIF(lnBebe<=75,lnBebe,999)+lnColes)*(1.1^(nagra-1))/25,0)*25
\f1 \

\f0 lnTEnf=ROUND((lnIMC+lnTension+(lnFuma*1.5)+lnBebe+lnColes)*(1.2^(nagra-1))/25,0)*25
\f1 \

\f0 lnTILT=ROUND((lnIMC_ILT+lnTension+lnFuma_ILT+lnBebe_ILT+lnColes)*(1.1^(nagra-1))/25,0)*25
\f1 \

\f0 \'a0
\f1 \

\f0 IF EMPTY(lnTVida)
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnTVida=0
\f1 \

\f0 ENDIF
\f1 \

\f0 IF EMPTY(lnTInva)
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnTInva=0
\f1 \

\f0 ENDIF
\f1 \

\f0 IF EMPTY(lnTAcci)
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnTAcci=0
\f1 \

\f0 ENDIF
\f1 \

\f0 IF EMPTY(lnTEnf)
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnTEnf=0
\f1 \

\f0 ENDIF
\f1 \

\f0 IF EMPTY(lnTILT)
\f1 \

\f0 \'a0\'a0\'a0\'a0 lnTILT=0
\f1 \

\f0 ENDIF
\f1 \

\f0 \'a0
\f1 \

\f0 && Se fijan unos m\'e1ximos agravamientos que prevalecen al c\'e1lculo te\'f3rico, si se rebasa
\f1 \

\f0 lnMax=IIF(nagra<2,200,300)
\f1 \

\f0 \'a0
\f1 \

\f0 IF lnTVida>lnMax
\f1 \

\f0 \'a0\'a0\'a0\'a0 x=messagebox("Se ha excedido el l\'edmite",64,"Consulte con la Central")
\f1 \

\f0 \'a0\'a0\'a0\'a0 RETURN .f.
\f1 \

\f0 ENDIF
\f1 \

\f0 \'a0
\f1 \
